// Schéma de protocole — SOURCE DE VÉRITÉ partagée serveur (TS) / web (TS) / ESP32 (C++).
// Génère le code via `pnpm codegen` (flatc → TS dans gen-ts/, C++ dans gen-cpp/).
// Le format binaire FlatBuffers est utilisé sur le transport WebSocket.

namespace game.wire;

// --- Types de base ---------------------------------------------------------

struct Vec2 {
  x:float;
  y:float;
}

enum TileType : ubyte {
  Grass = 0,
  Dirt,
  Water,
  Stone,
  Sand,
  Forest,
  Farm,          // champ labouré, vide (plantable)
  ChampSeme,     // champ semé (graine en terre)
  ChampPousse,   // jeune pousse
  ChampMur,      // prêt à récolter
  Path,          // chemin (foulé ou pavé) : marche rapide
}

enum ActivityKind : ubyte {
  Idle = 0,
  Walking,
  Sleeping,
  Eating,
  Working,
  Crafting,
  Talking,
  Socializing,
  Trading,        // vente/achat au marché du village
  Washing,        // se laver au puits ou au bord de l'eau (hygiène)
}

// Besoins d'un agent, normalisés 0..100.
struct Needs {
  energy:float;   // sommeil
  hunger:float;   // faim (100 = rassasié)
  social:float;
  hygiene:float;
  fun:float;
}

// --- État du monde ---------------------------------------------------------

table ItemStack {
  kind:string;
  count:uint;
}

table AgentState {
  id:uint;
  name:string;
  pos:Vec2;
  activity:ActivityKind;
  needs:Needs;
  voice_profile:ubyte;   // index du profil vocal (timbre/pitch propre à l'IA)
  goal:string;           // objectif courant (lisible), fixé par l'orchestrateur LLM
  saying:string;         // réplique en cours (vide si silencieux)
  inventory:[ItemStack]; // ressources brutes + objets craftés
  houses:uint;           // bâtiments construits (aspiration logement)
  job:string;            // métier (fermier, bucheron, mineur, artisan, boulanger…)
  coins:uint;            // monnaie détenue (économie de marché)
  gender:ubyte;          // 0 = homme, 1 = femme
  age_years:uint;        // âge en années de jeu
  life_stage:ubyte;      // 0 = enfant, 1 = adulte, 2 = aîné
  partner_id:uint;       // id du/de la conjoint(e), 0 = célibataire
}

table ItemState {
  id:uint;
  kind:string;
  pos:Vec2;
}

table BuildingState {
  id:uint;
  kind:string;
  pos:Vec2;              // coin haut-gauche du footprint (en tuiles), ou centre si mono-tuile
  owner:uint;            // id de l'agent propriétaire (0 = bien public, ex : marché)
  footprint:Vec2;        // taille en tuiles (w, h) ; (0,0) → mono-tuile (rétro-compat)
  door:Vec2;             // tuile-porte en coordonnées monde absolues (seul point d'entrée)
}

// Tuiles : envoyées une fois (chunk statique) puis deltas si besoin.
table TileChunk {
  width:uint;
  height:uint;
  tiles:[ubyte];   // TileType aplati ligne par ligne
}

table WorldSnapshot {
  tick:ulong;
  time_of_day:float;     // 0..24 heures
  game_time:double;      // secondes de jeu écoulées (base des durées du monde)
  day_count:uint;        // jours de jeu écoulés
  date_year:uint;        // calendrier : année
  date_month:ubyte;      // calendrier : mois (1..12)
  date_day:ubyte;        // calendrier : jour (1..31)
  agents:[AgentState];
  items:[ItemState];
  buildings:[BuildingState];
  chunk:TileChunk;       // présent uniquement sur le premier snapshot
}

// --- Événements serveur -> client -----------------------------------------

table DialogueEvent {
  speaker_id:uint;
  listener_id:uint;      // 0 = adressé au monde / au joueur
  text:string;
  voice_profile:ubyte;
}

table AudioEvent {
  speaker_id:uint;
  voice_profile:ubyte;
  sample_rate:uint;
  pcm:[byte];            // PCM 16 bits mono (chemin Piper, joué en I2S sur ESP32)
}

// --- Messages client -> serveur --------------------------------------------

table Hello {
  client_kind:string;    // "web" | "esp32"
  view_w:uint;
  view_h:uint;
}

table ChatToAgent {
  agent_id:uint;
  text:string;           // message libre du joueur (ou ordre)
  is_order:bool;
}

table SetSpeed {
  scale:float;           // 0 = pause, 1 = base, >1 = accéléré
}

// --- Enveloppes (unions) ---------------------------------------------------

union ServerPayload { WorldSnapshot, DialogueEvent, AudioEvent }

table ServerMessage {
  payload:ServerPayload;
}

union ClientPayload { Hello, ChatToAgent, SetSpeed }

table ClientMessage {
  payload:ClientPayload;
}

root_type ServerMessage;
